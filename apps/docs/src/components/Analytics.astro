---
// GA4 for the Wire DSL property, loaded only after the visitor accepts.
// Runs on wire-dsl.org hosts only, skips Do Not Track / Global Privacy Control,
// keeps advertising storage denied and disables Google Signals.
---

<script is:inline>
(function () {
  var MEASUREMENT_ID = 'G-JRJRDEYCE0'
  var KEY = 'wire-dsl:analytics-consent'

  // Only on wire-dsl.org hosts, and never for visitors who send Do Not Track / GPC
  var host = location.hostname
  var onWireDsl = host === 'wire-dsl.org' || host.slice(-13) === '.wire-dsl.org'
  if (!onWireDsl || navigator.doNotTrack === '1' || navigator.globalPrivacyControl === true) return

  function read() {
    try { return localStorage.getItem(KEY) } catch (e) { return null }
  }
  function write(value) {
    try { localStorage.setItem(KEY, value) } catch (e) { /* choice is not remembered */ }
  }

  var loaded = false
  function load() {
    if (loaded) return
    loaded = true
    window.dataLayer = window.dataLayer || []
    window.gtag = function () { window.dataLayer.push(arguments) }
    // Advertising storage stays denied; only analytics storage is granted
    window.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'granted',
    })
    window.gtag('js', new Date())
    window.gtag('config', MEASUREMENT_ID, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    })
    var s = document.createElement('script')
    s.async = true
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + MEASUREMENT_ID
    document.head.appendChild(s)
  }

  function showBanner() {
    var style = document.createElement('style')
    style.textContent =
      '.wd-consent{position:fixed;left:16px;right:16px;bottom:16px;max-width:420px;z-index:2147483000;' +
      'padding:14px 16px;border-radius:10px;font:14px/1.45 system-ui,sans-serif;' +
      'background:#fff;color:#1f2328;border:1px solid #d0d7de;box-shadow:0 8px 24px rgba(0,0,0,.18)}' +
      '.wd-consent p{margin:0 0 10px}' +
      '.wd-consent-actions{display:flex;gap:8px;justify-content:flex-end}' +
      '.wd-consent button{font:inherit;padding:6px 14px;border-radius:6px;cursor:pointer;' +
      'border:1px solid #d0d7de;background:transparent;color:inherit}' +
      '.wd-consent button.wd-accept{background:#0969da;border-color:#0969da;color:#fff}' +
      '.wd-consent button:focus-visible{outline:2px solid #0969da;outline-offset:2px}' +
      '@media (prefers-color-scheme:dark){.wd-consent{background:#161b22;color:#e6edf3;border-color:#30363d}' +
      '.wd-consent button{border-color:#30363d}}'
    document.head.appendChild(style)

    var box = document.createElement('div')
    box.className = 'wd-consent'
    box.setAttribute('role', 'dialog')
    box.setAttribute('aria-label', 'Analytics consent')
    box.innerHTML =
      '<p>Can we use Google Analytics to count visits and improve these pages? ' +
      'No advertising cookies and no ad personalization.</p>' +
      '<div class="wd-consent-actions">' +
      '<button type="button" class="wd-decline">Decline</button>' +
      '<button type="button" class="wd-accept">Accept</button></div>'

    function close(value) {
      write(value)
      if (value === 'granted') load()
      box.remove()
      style.remove()
    }
    box.querySelector('.wd-accept').addEventListener('click', function () { close('granted') })
    box.querySelector('.wd-decline').addEventListener('click', function () { close('denied') })
    document.body.appendChild(box)
  }

  var stored = read()
  if (stored === 'granted') load()
  else if (stored !== 'denied') {
    if (document.body) showBanner()
    else document.addEventListener('DOMContentLoaded', showBanner)
  }
})()
</script>
